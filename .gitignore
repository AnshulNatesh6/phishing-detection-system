*.py[cod]
*$py.class
*.so

# Virtual Environments (do NOT commit virtual environments)
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
!.env.example

# IDE & Editor Specific
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.project
.pydevproject

